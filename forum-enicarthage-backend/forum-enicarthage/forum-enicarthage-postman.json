{
  "info": {
    "name": "Forum ENICarthage API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Admin ENI\",\n  \"email\": \"admin@enicarthage.tn\",\n  \"motDePasse\": \"Admin@1234\",\n  \"role\": \"ADMIN\"\n}" }
          }
        },
        {
          "name": "Login (auto-save token)",
          "event": [{ "listen": "test", "script": { "exec": ["const j=pm.response.json();if(j.token){pm.collectionVariables.set('token',j.token);console.log('Token saved');}"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@enicarthage.tn\",\n  \"motDePasse\": \"Admin@1234\"\n}" }
          }
        },
        {
          "name": "Register Membre",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Membre Test\",\n  \"email\": \"membre@enicarthage.tn\",\n  \"motDePasse\": \"Membre@1234\",\n  \"role\": \"MEMBRE\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Utilisateurs",
      "item": [
        { "name": "Get All", "request": { "method": "GET", "url": "{{baseUrl}}/api/utilisateurs", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Get By Id", "request": { "method": "GET", "url": "{{baseUrl}}/api/utilisateurs/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Activer Compte", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/utilisateurs/2/activer?actif=true", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Assigner Role CHEF_COMITE", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/utilisateurs/2/role?role=CHEF_COMITE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "Forum Projects",
      "item": [
        { "name": "Get All", "request": { "method": "GET", "url": "{{baseUrl}}/api/forum-projects", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Get Historique", "request": { "method": "GET", "url": "{{baseUrl}}/api/forum-projects/historique", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Creer Forum",
          "event": [{ "listen": "test", "script": { "exec": ["const j=pm.response.json();if(j.id)pm.collectionVariables.set('forumId',j.id);"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/forum-projects",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Forum Entreprise ENICarthage 2025\",\n  \"edition\": \"XI\",\n  \"dateDebut\": \"2025-03-01\",\n  \"dateEvenement\": \"2025-04-15\",\n  \"lieu\": \"ENICarthage, Carthage\",\n  \"description\": \"11eme edition du Forum ENICarthage\"\n}" }
          }
        },
        { "name": "Archiver Forum", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/forum-projects/1/archiver", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "Comites",
      "item": [
        { "name": "Get All", "request": { "method": "GET", "url": "{{baseUrl}}/api/comites", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Creer Comite",
          "event": [{ "listen": "test", "script": { "exec": ["const j=pm.response.json();if(j.id)pm.collectionVariables.set('comiteId',j.id);"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/comites",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Comite Logistique\",\n  \"description\": \"Gestion logistique et accueil\",\n  \"forumProject\": { \"id\": 1 },\n  \"membres\": []\n}" }
          }
        },
        { "name": "Ajouter Membre", "request": { "method": "POST", "url": "{{baseUrl}}/api/comites/1/membres?utilisateurId=2", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Retirer Membre", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/comites/1/membres?utilisateurId=2", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "Taches",
      "item": [
        { "name": "Get All", "request": { "method": "GET", "url": "{{baseUrl}}/api/taches", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Creer Tache",
          "event": [{ "listen": "test", "script": { "exec": ["const j=pm.response.json();if(j.id)pm.collectionVariables.set('tacheId',j.id);"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/taches",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titre\": \"Preparer les badges\",\n  \"description\": \"Imprimer les badges participants\",\n  \"dateDebut\": \"2025-03-10\",\n  \"dateFin\": \"2025-04-01\",\n  \"priorite\": \"URGENTE\",\n  \"comiteId\": 1,\n  \"membreId\": 2\n}" }
          }
        },
        { "name": "Changer Statut EN_COURS", "request": { "method": "PUT", "url": "{{baseUrl}}/api/taches/1/statut?statut=EN_COURS", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Changer Statut TERMINEE", "request": { "method": "PUT", "url": "{{baseUrl}}/api/taches/1/statut?statut=TERMINEE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Creer Tache EN RETARD (test scheduler)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/taches",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titre\": \"Tache expiree test\",\n  \"description\": \"Pour tester la detection de retard\",\n  \"dateDebut\": \"2024-01-01\",\n  \"dateFin\": \"2024-01-15\",\n  \"priorite\": \"NORMALE\",\n  \"comiteId\": 1,\n  \"membreId\": 2\n}" }
          }
        }
      ]
    },
    {
      "name": "Workshops",
      "item": [
        { "name": "Get All", "request": { "method": "GET", "url": "{{baseUrl}}/api/workshops", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Proposer Workshop",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/workshops",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titre\": \"Workshop IA & Emploi\",\n  \"description\": \"L'IA transforme le marche de l'emploi\",\n  \"intervenant\": \"Dr. Ahmed Ben Salem\",\n  \"dateHeure\": \"2025-04-15T10:00:00\",\n  \"comite\": { \"id\": 1 },\n  \"proposePar\": { \"id\": 1 }\n}" }
          }
        },
        { "name": "Valider Workshop", "request": { "method": "PUT", "url": "{{baseUrl}}/api/workshops/1/valider", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Refuser Workshop", "request": { "method": "PUT", "url": "{{baseUrl}}/api/workshops/1/refuser", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "Candidatures CV",
      "item": [
        { "name": "Get All", "request": { "method": "GET", "url": "{{baseUrl}}/api/candidatures", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Upload CV", "request": { "method": "POST", "url": "{{baseUrl}}/api/candidatures/upload",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "fichier", "type": "file", "src": "/chemin/vers/cv.pdf" }, { "key": "posteVise", "value": "Developpeur Full Stack", "type": "text" }] }
          }
        },
        { "name": "Accepter Candidature", "request": { "method": "PUT", "url": "{{baseUrl}}/api/candidatures/1/accepter", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Refuser Candidature", "request": { "method": "PUT", "url": "{{baseUrl}}/api/candidatures/1/refuser?commentaire=Profil insuffisant", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        { "name": "Mes Notifications", "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications/mes-notifications", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Non Lues", "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications/non-lues", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Marquer Lu", "request": { "method": "PUT", "url": "{{baseUrl}}/api/notifications/1/lu", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "Statistiques",
      "item": [
        { "name": "KPIs Global", "request": { "method": "GET", "url": "{{baseUrl}}/api/stats/kpis", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Avancement par Comite", "request": { "method": "GET", "url": "{{baseUrl}}/api/stats/comites", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Comparer Editions", "request": { "method": "GET", "url": "{{baseUrl}}/api/stats/editions", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "Cas Erreur",
      "item": [
        { "name": "Sans token 403", "request": { "method": "GET", "url": "{{baseUrl}}/api/utilisateurs" } },
        { "name": "Token invalide", "request": { "method": "GET", "url": "{{baseUrl}}/api/taches", "header": [{ "key": "Authorization", "value": "Bearer token-invalide" }] } },
        { "name": "Ressource 404", "request": { "method": "GET", "url": "{{baseUrl}}/api/taches/99999", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Mauvais mot de passe", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@enicarthage.tn\",\n  \"motDePasse\": \"MAUVAIS\"\n}" }
          }
        }
      ]
    }
  ]
}
